# Copy this file to .env and fill in your own values.

# CoinMarketCap Pro API key. Leave empty/unset to run in demo mode
# (all prices come from fallbackPriceUsd in holdings.json).
CMC_API_KEY=

# Port the server listens on (bound to 127.0.0.1 only).
PORT=3000

# How long (in seconds) a price refresh is cached before the next request
# triggers a new upstream fetch.
REFRESH_SECONDS=300

# Overrides below are for testing only; leave unset to use the real hosts.
# CMC_BASE_URL=https://pro-api.coinmarketcap.com
# DEXSCREENER_BASE_URL=https://api.dexscreener.com
# FIXED_NOW=2026-01-01T00:00:00.000Z
# DATA_DIR=./data
# UPSTREAM_TIMEOUT_MS=8000
# MIN_LIQUIDITY_USD=1000
