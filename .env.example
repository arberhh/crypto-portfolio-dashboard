# Copy this file to .env and fill in your own values.

# CoinMarketCap Pro API key. Leave empty/unset to run in demo mode
# (all prices come from fallbackPriceUsd in holdings.json).
CMC_API_KEY=

# Port the server listens on.
PORT=3000

# Host to bind to. Leave unset for 127.0.0.1 (local-only). Set to 0.0.0.0
# when deploying so the host platform can route traffic to the process.
# HOST=0.0.0.0

# Shared password for HTTP Basic Auth. Leave empty/unset to disable auth
# entirely (fine for local-only use). REQUIRED if this is deployed
# anywhere reachable from the public internet — without it, anyone with
# the URL can see your live holdings, amounts, and P&L.
# DASHBOARD_PASSWORD=

# How long (in seconds) a price refresh is cached before the next request
# triggers a new upstream fetch.
REFRESH_SECONDS=300

# Overrides below are for testing only; leave unset to use the real hosts.
# CMC_BASE_URL=https://pro-api.coinmarketcap.com
# DEXSCREENER_BASE_URL=https://api.dexscreener.com
# FIXED_NOW=2026-01-01T00:00:00.000Z
# DATA_DIR=./data
# UPSTREAM_TIMEOUT_MS=8000
# MIN_LIQUIDITY_USD=1000
